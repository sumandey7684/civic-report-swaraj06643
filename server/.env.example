DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
AUTH_PORT=4000
GOOGLE_CLOUD_PROJECT=your-google-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_VISION_MODEL=gemini-2.0-flash-001

# Optional authority handoff endpoints. Reports are stored as queued when unset.
AUTHORITY_WEBHOOK_PUBLIC_WORKS=https://government.example/api/public-works/issues
AUTHORITY_WEBHOOK_WATER_SUPPLY=https://government.example/api/water-supply/issues
AUTHORITY_WEBHOOK_ELECTRICITY=https://government.example/api/electricity/issues
AUTHORITY_WEBHOOK_WASTE_MANAGEMENT=https://government.example/api/waste-management/issues
AUTHORITY_WEBHOOK_STREET_LIGHTING=https://government.example/api/street-lighting/issues
AUTHORITY_WEBHOOK_DRAINAGE=https://government.example/api/drainage/issues
AUTHORITY_WEBHOOK_MUNICIPAL_GRIEVANCE=https://government.example/api/municipal-grievance/issues
AUTHORITY_WEBHOOK_SECRET=replace-with-the-shared-webhook-secret
